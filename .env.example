# Google Sheet used as the live data source.
# The sheet must be shared as "Anyone with the link can view".
# We read it as CSV export, so no API key / service account is required.
#
# How to get this URL:
# 1. Open the sheet -> File -> Share -> Publish to web (or just "Anyone with link: Viewer")
# 2. Use this pattern, replacing SHEET_ID and GID (tab id, 0 for first tab):
#    https://docs.google.com/spreadsheets/d/SHEET_ID/export?format=csv&gid=GID
NEXT_PUBLIC_SHEET_ID=17RgspooE9Zixe6-BqxevJA29tpEqdwEgwAJwGFgEOkY
NEXT_PUBLIC_SHEET_GID=0

# Used by sitemap.xml / robots.txt. Set this to your real Netlify/
# custom domain before deploying (falls back to a placeholder).
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app

# How often (seconds) the server refetches the sheet before serving stale data.
# Low value = near-instant updates when you edit the sheet, at the cost of more requests.
SHEET_REVALIDATE_SECONDS=30

# Admin Panel (Milestone 7). Change both before deploying.
# ADMIN_PASSWORD: the single shared password to access /admin.
# ADMIN_SESSION_SECRET: any long random string, used to sign the login
# session cookie — it's not a password itself, just needs to be secret
# and stable (changing it logs everyone out).
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-this-to-a-long-random-string
